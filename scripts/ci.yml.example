name: macOS build
on: [push, pull_request]
permissions:
  contents: read
jobs:
  test:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
      - name: Test
        run: swift test
      - name: Build app
        run: ./scripts/build-app.sh
      - name: Archive development build
        run: ditto -c -k --keepParent dist/W.app dist/W-development.zip
      - uses: actions/upload-artifact@v4
        with:
          name: W-development
          path: dist/W-development.zip
